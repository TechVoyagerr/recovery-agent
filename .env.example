# Local SQLite, resolved relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Keep off for the reproducible, zero-LLM-cost demo
AGENT_LLM=off
# Optional credentials. Leave empty for mock mode; replace with your own values for live use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for production mutations, including the inbound adapter
DEMO_API_TOKEN=
# Worker target
AGENT_BASE_URL=http://localhost:3000
# Next build output; npm run dev overrides this with .next-dev
NEXT_DIST_DIR=.next
# NODE_ENV is set by Next.js. Do not override for normal use.
